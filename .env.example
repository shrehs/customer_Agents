# OpenAI API Configuration
OPENAI_API_KEY=your_openai_api_key_here

# Database Configuration
DATABASE_URL=sqlite:///./medical_ai.db
# For PostgreSQL (production): postgresql://username:password@hostname:port/database_name

# JWT Authentication
JWT_SECRET=your_super_secret_jwt_key_here_should_be_at_least_32_characters_long
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

# Application Settings
APP_NAME=Medical AI Appointment System
APP_VERSION=1.0.0
DEBUG=True

# Server Configuration
HOST=0.0.0.0
PORT=8000

# CORS Settings (for frontend integration)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080,http://127.0.0.1:3000

# CrewAI Configuration
CREW_AI_VERBOSE=True
CREW_AI_MAX_TOKENS=1000